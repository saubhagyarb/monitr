pkgname=monitr
pkgver=0.1.0
pkgrel=1
pkgdesc='Manage monitor settings — resolution, refresh rate, position, rotation, and scale'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/monitr "$pkgdir/usr/bin/monitr"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/monitr.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/monitr.svg"
  install -Dm644 "$startdir/monitr.desktop" "$pkgdir/usr/share/applications/monitr.desktop"
}
